{
  "manifest_version": 3,
  "name": "Council \u2014 AI Group Chat",
  "version": "0.1.4",
  "description": "A local group conversation with your signed-in ChatGPT, Grok and Gemini tabs.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://grok.com/*",
    "https://gemini.google.com/*"
  ],
  "action": {
    "default_title": "Open Council"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://grok.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "bridge.js"
      ]
    }
  ]
}